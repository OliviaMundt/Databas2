@{

    ViewData["Title"] = "Lägg till recept";

}

@model Labb2.Models.Food

<h1>Lägg till recept</h1>



<p>

    <a asp-controller="Recept" asp-action="CreateFood" class="btn btn-primary">Lägg till recept</a>

</p>

<form asp-action="CreateFood" asp-controller="Recept">
    <label>FoodId</label>
    <input class="form-control" type="number" placeholder="0" asp-for="FoodId" />

    <label class="mt-4">Name</label>
    <input class="form-control" type="text" placeholder="Add the name" asp-for="Name" />

    <label class="mt-4">Time</label>
    <input class="form-control" type="number" placeholder="0" asp-for="Time" />

    <button class="btn btn-primary mt-4" type="submit">Ok</button>
</form>