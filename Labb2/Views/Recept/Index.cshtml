@model IEnumerable<Labb2.Models.Food>



@{

    ViewData["Title"] = "Mina recept";

}



<h1>Mina recept</h1>



<p>

    <a asp-controller="Recept" asp-action="CreateFood" class="btn btn-primary">Lägg till recept</a>

</p>

<table class="table">

    <thead>

        <tr>

            <th>

                @Html.DisplayNameFor(model => model.Name)

            </th>

            <th>

                @Html.DisplayNameFor(model => model.Time)

            </th>

            <th></th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {

            <tr>

                <td>

                    @Html.DisplayFor(model => item.Name)

                </td>

                <td>

                    @Html.DisplayFor(model => item.Time)

                </td>

                <td>

                    <a asp-action="Edit" asp-route-id="@item.FoodId">Edit</a> |

                    <a asp-action="Details" asp-route-id="@item.FoodId">Details</a> |

                    <a asp-action="Delete" asp-route-id="@item.FoodId">Delete</a>

                </td>

            </tr>

        }

    </tbody>

</table>