

@model Labb2.Models.CreateDishViewModel


<h1>Lägg till recept</h1>



<p>

    <a asp-controller="Dish" asp-action="Create" class="btn btn-primary">Lägg till recept</a>

</p>

<form asp-action="Create" asp-controller="Dish">

    <label class="mt-4">Name</label>
    <input class="form-control" type="text" placeholder="Add the name" asp-for="Name" />

    <label class="mt-4">Time</label>
    <input class="form-control" type="number" placeholder="0" asp-for="Time" />
    


    @foreach (Diet diet in Model.AllDiets)
    {
        <div>
            <input type="checkbox" value="@diet.DietId" name="ChosenDiets" /> @diet.Name
        </div>
    }

  

    <button class="btn btn-primary mt-4" type="submit">Ok</button>
</form>