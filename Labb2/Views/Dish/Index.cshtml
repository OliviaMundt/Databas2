@model IEnumerable<Labb2.Models.Dish>



@{

    ViewData["Title"] = "Mina recept";

}



<h1>Mina recept</h1>



<p>

    <a asp-controller="Dish" asp-action="Create" class="btn btn-primary">Lägg till recept</a>
    <a asp-controller="Dish" asp-action="Plan" class="btn btn-info">Planera matlagning</a>

</p>

<table class="table">

    <thead>

        <tr>

            <th>

                @Html.DisplayNameFor(model => model.Name)

            </th>

            <th>

                @Html.DisplayNameFor(model => model.Time)

            </th>

            <th></th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {

            <tr>

                <td>

                    @Html.DisplayFor(model => item.Name)

                </td>

                <td>

                    @Html.DisplayFor(model => item.Time)

                </td>

                <td>
                    @if (item.Diets != null)
                    {
                        foreach (var diet in item.Diets)
                        {
                            <span>@diet.Name </span>
                        }
                    }
                </td>

                <td>

                    <a asp-action="Edit" asp-route-id="@item.DishId">Edit</a> |

                    <a asp-action="Details" asp-route-id="@item.DishId">Details</a> |

                    <a asp-action="Delete" asp-route-id="@item.DishId">Delete</a>

                </td>

            </tr>

        }

    </tbody>

</table>